# Postgres. Local Homebrew default shown; managed URLs (postgres://…) work as-is.
DATABASE_URL=postgresql+psycopg://localhost/airhoops
# Frontend origins allowed to call the API (comma-separated), e.g. https://airhoops.vercel.app
ALLOWED_ORIGINS=http://localhost:3000
MAX_PLAYERS=4
RECONNECT_GRACE_S=30
HEARTBEAT_TIMEOUT_S=25
SWEEP_INTERVAL_S=5
# Google sign-in (optional): OAuth 2.0 Web client ID from Google Cloud Console.
# Must match the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID. Empty = Google sign-in disabled.
GOOGLE_CLIENT_ID=
# Monitoring (optional): Sentry project DSN; leave empty to only log.
SENTRY_DSN=
ENVIRONMENT=development
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
