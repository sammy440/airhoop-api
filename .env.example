# Postgres (local Homebrew default shown). Production: your managed Postgres URL.
DATABASE_URL=postgresql+psycopg://localhost/airhoops
# Frontend origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
MAX_PLAYERS=4
RECONNECT_GRACE_S=30
HEARTBEAT_TIMEOUT_S=25
SWEEP_INTERVAL_S=5
